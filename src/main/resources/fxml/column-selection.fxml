<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.Region?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           alignment="TOP_CENTER"
           minHeight="0"
           fx:controller="com.sortinganalyzer.ui.controller.ColumnSelectionController">

    <padding>
        <Insets top="20" right="40" bottom="10" left="40"/>
    </padding>

    <!-- outer card -->
    <VBox spacing="6"
          alignment="TOP_LEFT"
          maxWidth="1000"
          minHeight="0"
          style="-fx-background-color: rgba(255,255,255,0.6);
                 -fx-background-radius: 15;
                 -fx-border-color: rgba(255,255,255,0.85);
                 -fx-border-radius: 15;
                 -fx-border-width: 1.5;
                 -fx-padding: 18;
                 -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.10), 15, 0, 0, 4);">

        <HBox spacing="10">
            <FontIcon iconLiteral="fas-list"
                      iconSize="30"
                      iconColor="#2563EB"/>

            <VBox>
                <Label text="Select Column"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;"/>

                <Label text="Choose the numeric column you want to sort"
                       style="-fx-font-size: 13px;"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox.margin>
                <Insets top="12"/>
            </VBox.margin>

            <Label text="Select Column"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;"/>

            <ComboBox fx:id="columnBox"
                      promptText="Choose a column"
                      prefWidth="200"
                      styleClass="column-combo"/>

            <Label text="Only numeric columns are listed"
                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
        </HBox>

        <!-- Dataset preview card -->
        <VBox spacing="10"
              VBox.vgrow="ALWAYS"
              minHeight="0"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-border-color: #E2E8F0;
                     -fx-border-radius: 12;
                     -fx-border-width: 1.5;
                     -fx-padding: 12;">

            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>

            <!-- header row -->
            <HBox alignment="TOP_LEFT" spacing="10">
                <FontIcon iconLiteral="fas-table"
                          iconSize="22"
                          iconColor="#2563EB"/>

                <VBox>
                    <Label text="Dataset Preview"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label fx:id="previewSubtitle"
                           style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
                </VBox>

                <!-- pushes the count label to the far right -->
                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="datasetSizeLabel"
                       style="-fx-background-color: #EFF6FF;
                              -fx-text-fill: #2563EB;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;
                              -fx-background-radius: 6;
                              -fx-padding: 4 10 4 10;"/>
            </HBox>

            <TableView fx:id="previewTable"
                       styleClass="preview-table"
                       VBox.vgrow="ALWAYS"
                       minHeight="120"
                       prefHeight="300">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

            </TableView>
        </VBox>

    </VBox>
</StackPane>