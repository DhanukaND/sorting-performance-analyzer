<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           alignment="CENTER"
           styleClass="run-screen"
           fx:controller="com.sortinganalyzer.ui.controller.RunAlgorithmsController">
    <VBox alignment="CENTER" maxWidth="580" spacing="14" styleClass="run-card">
        <padding>
            <Insets top="28" right="34" bottom="28" left="34"/>
        </padding>
        <Label text="Run Algorithms" styleClass="results-title"/>
        <Label text="Choose how many benchmark runs to perform for each sorting algorithm."
               styleClass="results-subtitle"/>
        <Label text="Benchmark run count" styleClass="run-label"/>
        <ComboBox fx:id="runCountBox" prefWidth="240" promptText="Select run count"
                  styleClass="run-count-box"/>
        <Label text="The results table will show only the selected run columns."
               styleClass="results-subtitle"/>
    </VBox>
</StackPane>
