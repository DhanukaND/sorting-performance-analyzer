<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            styleClass="screen-background"
            fx:controller="com.sortinganalyzer.ui.controller.MainLayoutController">

    <top>
        <fx:include fx:id="stepper" source="components/stepper.fxml"/>
    </top>

    <center>
        <StackPane fx:id="contentHolder" minHeight="0"/>
    </center>

    <bottom>
        <StackPane style="-fx-background-color: white;
                      -fx-border-color: #E2E8F0;
                      -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="15" right="40" bottom="15" left="40"/>
            </padding>

            <!-- true center of the window -->
            <HBox fx:id="extraActions"
                  alignment="CENTER"
                  spacing="10"
                  maxWidth="-Infinity"
                  StackPane.alignment="CENTER"/>

            <Button fx:id="backButton" text="Back" onAction="#handleBack"
                    styleClass="nav-button-secondary"
                    StackPane.alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left" iconSize="14"/>
                </graphic>
            </Button>

            <Button fx:id="nextButton" text="Next" onAction="#handleNext"
                    styleClass="nav-button-primary"
                    contentDisplay="RIGHT"
                    StackPane.alignment="CENTER_RIGHT">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-right" iconSize="14"/>
                </graphic>
            </Button>
        </StackPane>
    </bottom>
</BorderPane>
